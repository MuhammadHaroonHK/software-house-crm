// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  PROJECT_MANAGER
  EMPLOYEE
  CLIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  TASK
  PROJECT
  MEETING
  PAYMENT
  SYSTEM
}

enum FileType {
  IMAGE
  PDF
  DOCUMENT
  SPREADSHEET
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
}

enum FileModule {
  PROJECT
  CLIENT
  QUOTATION
  INVOICE
  MEETING
  COMPANY
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        UserRole @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  roleId       String  @db.Uuid
  departmentId String? @db.Uuid

  firstName    String
  lastName     String
  email        String  @unique
  password     String
  phone        String?
  profileImage String?

  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role                Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managedProjects     Project[]            @relation("ManagedProjects")
  projectMembers      ProjectMember[]
  assignedTasks       Task[]               @relation("AssignedTasks")
  organizedMeetings   Meeting[]            @relation("OrganizedMeetings")
  meetingParticipants MeetingParticipant[]
  notifications       Notification[]
  uploadedFiles       File[]
  auditLogs           AuditLog[]
  payments            Payment[]

  @@index([roleId])
  @@index([departmentId])
}

model Client {
  id          String  @id @default(uuid()) @db.Uuid
  companyName String
  industry    String?
  website     String?
  email       String  @unique
  phone       String?
  address     String?
  city        String?
  country     String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactPersons ContactPerson[]
  projects       Project[]
  quotations     Quotation[]
}

model ContactPerson {
  id       String @id @default(uuid()) @db.Uuid
  clientId String @db.Uuid

  firstName   String
  lastName    String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, isPrimary])
}

model Project {
  id        String @id @default(uuid()) @db.Uuid
  clientId  String @db.Uuid
  managerId String @db.Uuid

  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?      @db.Decimal(12, 2)
  status      ProjectStatus @default(PLANNING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  manager User   @relation("ManagedProjects", fields: [managerId], references: [id], onDelete: Restrict)

  members    ProjectMember[]
  tasks      Task[]
  meetings   Meeting[]
  quotations Quotation[]

  @@index([clientId])
  @@index([managerId])
}

model ProjectMember {
  projectId String @db.Uuid
  userId    String @db.Uuid

  joinedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Task {
  id           String @id @default(uuid()) @db.Uuid
  projectId    String @db.Uuid
  assignedToId String @db.Uuid

  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([assignedToId])
}

model Meeting {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  organizerId String @db.Uuid

  title       String
  agenda      String?
  meetingDate DateTime
  location    String?
  notes       String?
  aiSummary   String?

  status MeetingStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer User    @relation("OrganizedMeetings", fields: [organizerId], references: [id], onDelete: Restrict)

  participants MeetingParticipant[]

  @@index([projectId])
  @@index([organizerId])
}

model MeetingParticipant {
  meetingId String @db.Uuid
  userId    String @db.Uuid

  joinedAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model Quotation {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @db.Uuid
  projectId String? @db.Uuid

  quotationNumber String    @unique
  issueDate       DateTime
  expiryDate      DateTime?

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  status QuotationStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  items   QuotationItem[]
  invoice Invoice?

  @@index([clientId])
  @@index([projectId])
}

model QuotationItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @db.Uuid

  serviceName String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Invoice {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @unique @db.Uuid

  invoiceNumber String   @unique
  issueDate     DateTime
  dueDate       DateTime

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balanceDue  Decimal @db.Decimal(12, 2)

  status InvoiceStatus @default(DRAFT)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid

  serviceName String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @db.Uuid

  amount Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  paymentDate   DateTime?

  accountTitle  String?
  accountNumber String?

  receiptImage String?

  referenceNumber String?

  status PaymentStatus @default(PENDING)

  verifiedAt   DateTime?
  verifiedById String?   @db.Uuid

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([verifiedById])
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  title   String
  message String
  type    NotificationType

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id           String @id @default(uuid()) @db.Uuid
  uploadedById String @db.Uuid

  fileName     String
  originalName String
  filePath     String
  fileSize     Int
  mimeType     String
  fileType     FileType

  module      FileModule
  referenceId String?    @db.Uuid

  createdAt DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById])
  @@index([referenceId])
}

model AuditLog {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid

  action      String
  module      String
  referenceId String? @db.Uuid

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([referenceId])
}

model CompanySetting {
  id String @id @default(uuid()) @db.Uuid

  companyName    String  @unique
  companyEmail   String
  companyPhone   String?
  companyAddress String?

  website String?
  logo    String?

  bankName      String?
  accountTitle  String?
  accountNumber String?
  iban          String?

  easyPaisaNumber String?
  jazzCashNumber  String?

  currency String @default("PKR")
  timezone String @default("Asia/Karachi")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
